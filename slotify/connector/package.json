{
    "name": "@slotify/connector",
    "version": "2.2.0",
    "publishConfig": {
        "registry": "https://npm.pkg.github.com/"
    },
    "types": "types.d.ts",
    "scripts": {
        "start": "vite",
        "start:dev": "npx onchange -i -k 'src/**/**.{ts,tsx,json}' -- npm run build:local",
        "append:version": "echo \"/*\" VERSION: \"$(cat $(pwd)/package.json | jq -r \".version\") */\" >> lib/connector.js",
        "append:code": "cat lib/connector.min.js >> lib/connector.js",
        "append:license": "cat lib/connector.min.js.LICENSE.txt >> lib/connector.js",
        "build": "rm -Rf lib/* && npm run build:bundle && npm run append:version && npm run append:code && npm run append:license && rm lib/connector.min.js && rm lib/connector.min.js.LICENSE.txt",
        "build:react": "tsc & vite build",
        "build:bundle": "webpack --config webpack.config.js --stats errors-warnings",
        "build:local": "npm run build && npx serve lib -p 3001",
        "lint": "eslint src/ --ext .js,.jsx,.ts,.tsx",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "docs": "npx mdpdf docs/CONNECTOR_OPERATOR_API.md; npx mdpdf docs/CONNECTOR_GAME_CLIENT_API.md; npx mdpdf docs/CONNECTOR_GUIDEBOOK.md;"
    },
    "dependencies": {
        "@jest/globals": "^30.0.5",
        "@rlx/feim": "^1.17.1",
        "@slotify/shared": "^2.1.1",
        "@testing-library/jest-dom": "^6.6.4",
        "@types/react": "^19.1.9",
        "@types/react-dom": "^19.1.7",
        "@types/react-modal": "^3.16.3",
        "@types/tinycolor2": "^1.4.6",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^8.38.0",
        "@typescript-eslint/parser": "^8.38.0",
        "@vitejs/plugin-react": "^4.7.0",
        "grommet": "^2.48.0",
        "grommet-icons": "^4.14.0",
        "i18next": "^25.3.2",
        "json-loader": "^0.5.7",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-modal": "^3.16.3",
        "terser-webpack-plugin": "^5.3.14",
        "tinycolor2": "^1.6.0",
        "ts-loader": "^9.5.2",
        "typescript": "^5.8.3",
        "uuid": "^11.1.0",
        "vite": "^7.0.6",
        "vite-tsconfig-paths": "^5.1.4",
        "webpack": "^5.101.0",
        "webpack-cli": "^6.0.1"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.32.0",
        "eslint": "^9.32.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^16.3.0",
        "onchange": "^7.1.0",
        "prettier": "^3.6.2"
    }
}
