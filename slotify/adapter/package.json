{
    "name": "@slotify/adapter",
    "version": "3.6.0",
    "author": "",
    "license": "UNLICENSED",
    "publishConfig": {
        "registry": "https://npm.pkg.github.com/@slotify"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/slotify/slotify.git"
    },
    "scripts": {
        "preversion": "npm test && npm run lint",
        "version": "",
        "postversion": "git push --tags",
        "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "jest --runInBand --detectOpenHandles",
        "docs": "npx mdpdf docs/WALLET_INTEGRATION.md; npx mdpdf docs/RGS_INTEGRATION.md; npx mdpdf docs/BACK_OFFICE_API.md; npx mdpdf docs/ADAPTER_GUIDEBOOK.md; npx mdpdf docs/WALLET_INTEGRATION_PROCESS.md",
        "build": "rm -Rf lib/* && tsc && mkdir lib/walletAdapter/softswiss && cp walletAdapter/softswiss/*.xml lib/walletAdapter/softswiss",
        "delete-source": " find . -type f -name '*.ts' -delete",
        "start": "node lib/index.js",
        "start:dev": "ts-node-dev --transpile-only --exit-child index.ts",
        "obfuscate": "npx --yes javascript-obfuscator --target=node --options-preset=low-obfuscation --output lib/ lib/"
    },
    "dependencies": {
        "@graphql-tools/graphql-file-loader": "^8.0.22",
        "@graphql-tools/load": "^8.1.2",
        "@graphql-tools/schema": "^10.0.25",
        "@graphql-tools/stitch": "^9.4.28",
        "@graphql-tools/utils": "^10.9.1",
        "@jest/globals": "^30.0.5",
        "@slotify/shared": "^2.2.0",
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/luxon": "^3.7.1",
        "@types/node": "^24.1.0",
        "@types/ssh2-sftp-client": "^9.0.5",
        "@types/supertest": "^6.0.3",
        "@types/uuid": "^10.0.0",
        "@types/xml2js": "^0.4.14",
        "bcrypt": "^6.0.0",
        "express": "^5.1.0",
        "express-validator": "^7.2.1",
        "graphql": "^16.11.0",
        "graphql-http": "^1.22.4",
        "graphql-request": "^6.1.0",
        "graphql-type-json": "^0.3.2",
        "ip-matching": "^2.1.2",
        "jest": "^30.0.5",
        "jsonwebtoken": "^9.0.2",
        "luxon": "^3.7.1",
        "pg": "^8.16.3",
        "prom-client": "^15.1.3",
        "ssh2-sftp-client": "^12.0.1",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.0",
        "typeorm": "^0.3.25",
        "typescript": "^5.8.3",
        "uuid": "^11.1.0",
        "xml2js": "^0.6.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.32.0",
        "@typescript-eslint/eslint-plugin": "^8.38.0",
        "@typescript-eslint/parser": "^8.38.0",
        "eslint": "^9.32.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^16.3.0",
        "prettier": "^3.6.2",
        "ts-node-dev": "^2.0.0"
    }
}
