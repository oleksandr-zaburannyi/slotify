{
    "name": "@slotify/websocket",
    "version": "2.1.10",
    "author": "",
    "license": "UNLICENSED",
    "publishConfig": {
        "registry": "https://npm.pkg.github.com/@slotify"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/slotify/slotify.git"
    },
    "scripts": {
        "preversion": "npm test && npm run lint",
        "version": "",
        "postversion": "git push --tags",
        "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "jest --runInBand",
        "docs": "",
        "build": "rm -Rf lib/* && tsc",
        "delete-source": " find . -type f -name '*.ts' -delete",
        "start": "node lib/index.js",
        "start:dev": "ts-node-dev --transpile-only --exit-child index.ts",
        "obfuscate": "npx --yes javascript-obfuscator --target=node --options-preset=low-obfuscation --output lib/ lib/"
    },
    "dependencies": {
        "@jest/globals": "^30.0.5",
        "@slotify/shared": "^2.1.11",
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.1.0",
        "@types/supertest": "^6.0.3",
        "@types/uuid": "^10.0.0",
        "@types/ws": "^8.18.1",
        "eslint": "^9.32.0",
        "express": "^5.1.0",
        "express-validator": "^7.2.1",
        "typescript": "^5.8.3",
        "uuid": "^11.1.0",
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.32.0",
        "@typescript-eslint/eslint-plugin": "^8.38.0",
        "@typescript-eslint/parser": "^8.38.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^16.3.0",
        "jest": "^30.0.5",
        "prettier": "^3.6.2",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.0",
        "ts-node-dev": "^2.0.0"
    }
}
